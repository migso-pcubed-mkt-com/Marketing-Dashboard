# Supabase (required for primary storage)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# GitHub (optional, secondary storage)
# GITHUB_TOKEN is set server-side only (Vercel env vars)

# Guest auth (optional)
# GUEST_PASSWORD is set server-side only (Vercel env vars)
